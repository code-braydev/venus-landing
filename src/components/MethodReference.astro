---
import DocMethod from "./DocMethod.astro";
import GenericExplainer from "./GenericExplainer.astro";
---

<div class="space-y-32">
  <GenericExplainer />

  <section
    class="p-8 rounded-2xl bg-purple-500/3 border border-purple-500/10 mb-20"
  >
    <div class="flex items-center gap-3 mb-6">
      <div class="p-2 bg-purple-500/20 rounded-lg">
        <svg
          xmlns="http://www.w3.org/2000/svg"
          width="20"
          height="20"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          class="text-purple-400"
          ><path
            d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"
          ></path><polyline points="3.27 6.96 12 12.01 20.73 6.96"
          ></polyline><line x1="12" y1="22.08" x2="12" y2="12"></line></svg
        >
      </div>
      <div>
        <h3 class="text-xl font-bold text-white">Anatomy of a Response</h3>
        <p class="text-xs text-purple-100/30 uppercase tracking-widest mt-1">
          What Venus returns
        </p>
      </div>
    </div>

    <p class="text-sm text-purple-100/40 mb-8 leading-relaxed">
      Every method in Venus returns a predictable contract. No try/catch is
      required for normal control flow; check <code>ok</code> and render from there.
    </p>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-5 gap-4">
      <div
        class="p-4 rounded-xl bg-black/40 border border-white/5 hover:border-purple-500/20 transition-colors group"
      >
        <code class="text-purple-300 font-bold block mb-1">data: T | null</code>
        <p class="text-[11px] text-purple-100/30 italic">
          Parsed payload from json/text/blob/formData/arrayBuffer.
        </p>
      </div>
      <div
        class="p-4 rounded-xl bg-black/40 border border-white/5 hover:border-purple-500/20 transition-colors group"
      >
        <code class="text-green-400 font-bold block mb-1">ok: boolean</code>
        <p class="text-[11px] text-purple-100/30 italic">
          True when request succeeded.
        </p>
      </div>
      <div
        class="p-4 rounded-xl bg-black/40 border border-white/5 hover:border-purple-500/20 transition-colors group"
      >
        <code class="text-blue-400 font-bold block mb-1">status?: number</code>
        <p class="text-[11px] text-purple-100/30 italic">
          HTTP status when available.
        </p>
      </div>
      <div
        class="p-4 rounded-xl bg-black/40 border border-white/5 hover:border-purple-500/20 transition-colors group"
      >
        <code class="text-red-400 font-bold block mb-1"
          >error: string | null</code
        >
        <p class="text-[11px] text-purple-100/30 italic">
          Human-readable message for logs/UI.
        </p>
      </div>
      <div
        class="p-4 rounded-xl bg-black/40 border border-white/5 hover:border-purple-500/20 transition-colors group"
      >
        <code class="text-orange-400 font-bold block mb-1">errorCode</code>
        <p class="text-[11px] text-purple-100/30 italic">
          HTTP_ERROR, TIMEOUT, ABORTED, NETWORK_ERROR and more.
        </p>
      </div>
    </div>
  </section>

  <DocMethod
    id="get"
    method="GET"
    color="bg-blue-500/10 text-blue-400 border-blue-500/20"
    syntax="get<T>(path, options?)"
    description="Fetch resources with smart parsing, query params, timeout and retry controls. responseType: auto detects JSON vs text payloads."
    status="200 OK"
  >
    <pre
      slot="code"
      class="font-mono text-xs leading-relaxed text-purple-100/90">{`const { data, ok, errorCode } = await get<User>("/profile", {
  params: { include: ["roles"] },
  responseType: "auto",
  timeout: 8000,
});

if (!ok) return handleError(errorCode);
console.log(data?.name);`}</pre>
  </DocMethod>

  <DocMethod
    id="getRss"
    method="GET RSS"
    color="bg-cyan-500/10 text-cyan-400 border-cyan-500/20"
    syntax="getRss(path, options?)"
    description="Fetch and normalize RSS/Atom feeds with strict or lenient modes for non-standard XML sources."
    status="200 OK"
  >
    <pre
      slot="code"
      class="font-mono text-xs leading-relaxed text-purple-100/90">{`const feedResult = await getRss("https://hnrss.org/frontpage", {
  timeout: 8000,
  retry: true,
  rssMode: "strict",
});

if (feedResult.ok) {
  console.log(feedResult.data.items[0]?.title);
}`}</pre>
  </DocMethod>

  <DocMethod
    id="send"
    method="POST"
    color="bg-green-500/10 text-green-400 border-green-500/20"
    syntax="send<T>(path, body, options?)"
    description="Create resources with retry policy and hooks support for request/response instrumentation."
    status="201 Created"
  >
    <pre
      slot="code"
      class="font-mono text-xs leading-relaxed text-purple-100/90">{`const payload = { name: "Brayan" };

await send("/users", payload, {
  retry: { attempts: 2, backoffMs: 200 },
  hooks: {
    afterResponse: () => console.log("done"),
  },
});`}</pre>
  </DocMethod>

  <DocMethod
    id="update"
    method="PUT / PATCH"
    color="bg-orange-500/10 text-orange-400 border-orange-500/20"
    syntax="update<T>(path, body, options?)"
    description="Use update for full replacement (PUT) and updateOnly for partial changes (PATCH) with the same options model."
    status="200 OK"
  >
    <pre
      slot="code"
      class="font-mono text-xs leading-relaxed text-purple-100/90">{`await updateOnly("/users/1", { active: false }, {
  timeout: 6000,
});`}</pre>
  </DocMethod>

  <DocMethod
    id="remove"
    method="DELETE"
    color="bg-red-500/10 text-red-400 border-red-500/20"
    syntax="remove<T>(path, options?)"
    description="Delete resources with 204 handling and the same timeout/retry/hook controls available everywhere."
    status="204 No Content"
  >
    <pre
      slot="code"
      class="font-mono text-xs leading-relaxed text-purple-100/90">{`const { ok, status } = await remove("/id/10", { retry: 1 });

if (ok) refreshTable(status);`}</pre>
  </DocMethod>
</div>
